CONFIG_IDF_TARGET="esp32s3"

# DEBUG MODE: route ESP_LOGx to USB-Serial-JTAG so panic traces appear in
# `idf.py monitor`. This corrupts the data channel while the bridge is
# connected (log bytes interleave with our NDJSON), so flip back to
# CONFIG_ESP_CONSOLE_UART_DEFAULT=y once the bridge-kill hang is diagnosed
# and the spec-mandated channel separation is restored.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# SSH tunnel spike: Wi-Fi + mbedTLS + libssh2 won't fit the 1 MB default
# factory partition. The custom table keeps the app at 0x10000 (so the
# flasher manifest offsets in scripts/make_manifest.py are unchanged) and
# grows it to 3 MB. Assumes >= 4 MB flash, which every supported board has.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
