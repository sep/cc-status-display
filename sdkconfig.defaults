CONFIG_IDF_TARGET="esp32s3"

# DEBUG MODE: route ESP_LOGx to USB-Serial-JTAG so panic traces appear in
# `idf.py monitor`. This corrupts the data channel while the bridge is
# connected (log bytes interleave with our NDJSON), so flip back to
# CONFIG_ESP_CONSOLE_UART_DEFAULT=y once the bridge-kill hang is diagnosed
# and the spec-mandated channel separation is restored.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# SSH tunnel spike: Wi-Fi + mbedTLS + libssh2 won't fit the 1 MB default
# factory partition. The custom table keeps the app at 0x10000 (so the
# flasher manifest offsets in scripts/make_manifest.py are unchanged) and
# grows it to 3 MB. Assumes >= 4 MB flash, which every supported board has.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# SSH tunnel spike: libssh2's session struct is ~80 KB in ONE allocation
# (two 35 KB packet buffers + an 8 KB banner buffer, sizes the SSH protocol
# mandates). Internal RAM rarely has a contiguous hole that big once Wi-Fi,
# lwIP, the HUB75 DMA buffers and the SSH task stack are up, so the first
# hardware run died in libssh2_session_init(). Enable PSRAM; ssh_tunnel.cpp
# hands libssh2 an allocator that prefers it. The PSRAM *mode* is per board
# (sdkconfig.board.*: octal for the Lonely Binary N16R8, quad for the
# SparkFun Thing Plus's ESP32-S3-MINI-1-N4R2) and must be passed alongside
# this file:  idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.board.<board>"
# IGNORE_NOTFOUND keeps a board booting if the mode is wrong or PSRAM is
# absent; it then falls back to internal RAM and may hit the same wall.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Also let Wi-Fi/lwIP take their big buffers from PSRAM, freeing internal RAM
# for everything that must stay there (DMA, task stacks).
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
